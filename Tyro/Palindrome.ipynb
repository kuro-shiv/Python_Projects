   "source": [
    "def Palindrome(str):\n",
    "    str = str.replace(\" \", \"\")\n",
    "    ls = list(str)\n",
    "    rev = reversed(ls)\n",
    "    if ''.join(rev) == str:\n",
    "        return \"true\" \n",
    "    return \"false\""
   ]
  },

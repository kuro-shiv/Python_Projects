   "source": [
    "def VowelCount(str):\n",
    "    count = 0\n",
    "    vowels = \"aeiou\"\n",
    "    for letter in str:\n",
    "        if letter.lower() in vowels:\n",
    "            count += 1\n",
    "    return count"
   ]
